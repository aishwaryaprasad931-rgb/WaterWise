jsx)(`span`,{children:l.login})]})]})]})})},nt={Vijayapura:{lat:16.8302,lon:75.71,zone:`Northern Dry Zone`,zone_kn:`ಉತ್ತರ ಒಣ ವಲಯ`},Bagalkot:{lat:16.1691,lon:75.6615,zone:`Northern Dry Zone`,zone_kn:`ಉತ್ತರ ಒಣ ವಲಯ`},Belagavi:{lat:15.8497,lon:74.4977,zone:`Northern Transition Zone`,zone_kn:`ಉತ್ತರ ಪರಿವರ್ತನಾ ವಲಯ`},Dharwad:{lat:15.4589,lon:75.0078,zone:`Northern Transition Zone`,zone_kn:`ಉತ್ತರ ಪರಿವರ್ತನಾ ವಲಯ`},Gadag:{lat:15.4319,lon:75.6355,zone:`Northern Dry Zone`,zone_kn:`ಉತ್ತರ ಒಣ ವಲಯ`},Haveri:{lat:14.7958,lon:75.3995,zone:`Northern Transition Zone`,zone_kn:`ಉತ್ತರ ಪರಿವರ್ತನಾ ವಲಯ`},Koppal:{lat:15.3456,lon:76.1549,zone:`Northern Dry Zone`,zone_kn:`ಉತ್ತರ ಒಣ ವಲಯ`},Raichur:{lat:16.212,lon:77.3439,zone:`North Eastern Dry Zone`,zone_kn:`ಈಶಾನ್ಯ ಒಣ ವಲಯ`},Ballari:{lat:15.1394,lon:76.9214,zone:`North Eastern Dry Zone`,zone_kn:`ಈಶಾನ್ಯ ಒಣ ವಲಯ`},Kalaburagi:{lat:17.3297,lon:76.8343,zone:`North Eastern Dry Zone`,zone_kn:`ಈಶಾನ್ಯ ಒಣ ವಲಯ`},Yadgir:{lat:16.7644,lon:77.1378,zone:`North Eastern Dry Zone`,zone_kn:`ಈಶಾನ್ಯ ಒಣ ವಲಯ`},Bidar:{lat:17.9104,lon:77.5199,zone:`North Eastern Transition Zone`,zone_kn:`ಈಶಾನ್ಯ ಪರಿವರ್ತನಾ ವಲಯ`},Mysuru:{lat:12.2958,lon:76.6394,zone:`Southern Dry Zone`,zone_kn:`ದಕ್ಷಿಣ ಒಣ ವಲಯ`},Mandya:{lat:12.5218,lon:76.8951,zone:`Southern Dry Zone`,zone_kn:`ದಕ್ಷಿಣ ಒಣ ವಲಯ`}},rt={Cotton:{season_water_mm:650,duration_days:150,kc:{initial:.35,mid:1.15,late:.65},drought_tolerance:`Medium`,suitable_soils:[`Black soil`,`Loamy`,`Clay`],critical_stages:[`Square Formation`,`Flowering`,`Boll Development`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Jowar (Sorghum) or Bajra`,name_kn:`ಹತ್ತಿ (Cotton)`,alternative_reason:`Jowar consumes 40% less water, has deep root extraction in Vertisols, and withstands dry spells.`},Rice:{season_water_mm:1200,duration_days:120,kc:{initial:1.05,mid:1.2,late:.9},drought_tolerance:`Low`,suitable_soils:[`Clay`,`Black soil`,`Loamy`],critical_stages:[`Panicle Initiation`,`Flowering`,`Grain Filling`],drip_suitable:!1,sprinkler_suitable:!1,recommended_alternative:`Ragi (Finger Millet) or Direct Seeded Rice (DSR)`,name_kn:`ಭತ್ತ (Paddy / Rice)`,alternative_reason:`Ragi requires only 350 mm compared to 1200 mm for flood paddy, saving over 70% irrigation water.`},Sugarcane:{season_water_mm:1800,duration_days:360,kc:{initial:.4,mid:1.25,late:.75},drought_tolerance:`Low`,suitable_soils:[`Loamy`,`Clay`,`Black soil`],critical_stages:[`Formative Stage`,`Grand Growth`],drip_suitable:!0,sprinkler_suitable:!1,recommended_alternative:`Jowar or Maize with Drip`,name_kn:`ಕಬ್ಬು (Sugarcane)`,alternative_reason:`Sugarcane requires year-round water. Under deficit conditions, switching to shorter-duration Jowar prevents total crop loss.`},Maize:{season_water_mm:500,duration_days:100,kc:{initial:.4,mid:1.15,late:.7},drought_tolerance:`Medium`,suitable_soils:[`Loamy`,`Red soil`,`Black soil`],critical_stages:[`Tasseling`,`Silking`,`Grain Filling`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Jowar (Sorghum)`,name_kn:`ಮೆಕ್ಕೆಜೋಳ (Maize)`,alternative_reason:`Jowar is more drought-resilient and requires 20% less water while tolerating high temperatures in Northern dry zones.`},Groundnut:{season_water_mm:450,duration_days:105,kc:{initial:.4,mid:1.1,late:.6},drought_tolerance:`Medium-High`,suitable_soils:[`Sandy`,`Red soil`,`Loamy`],critical_stages:[`Flowering`,`Pegging`,`Pod Development`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Horsegram (ಹುರುಳಿ) or Cowpea`,name_kn:`ಕಡಲೆಕಾಯಿ (Groundnut)`,alternative_reason:`Horsegram can survive prolonged dry spells in light red soils with minimal residual moisture.`},Jowar:{season_water_mm:400,duration_days:100,kc:{initial:.3,mid:1.05,late:.55},drought_tolerance:`High`,suitable_soils:[`Black soil`,`Loamy`,`Clay`],critical_stages:[`Boot Stage`,`Flowering`,`Grain Filling`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Pearl Millet (Bajra)`,name_kn:`ಜೋಳ (Jowar / Sorghum)`,alternative_reason:`Bajra has superior heat tolerance and can yield on coarse dry soils.`},Ragi:{season_water_mm:350,duration_days:110,kc:{initial:.3,mid:1,late:.55},drought_tolerance:`High`,suitable_soils:[`Red soil`,`Loamy`,`Sandy`],critical_stages:[`Tillering`,`Flowering`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Foxtail Millet (Navane) or Horsegram`,name_kn:`ರಾಗಿ (Finger Millet)`,alternative_reason:`Navane (Foxtail Millet) requires less than 250 mm water and matures in 75 days.`},Pulses:{season_water_mm:300,duration_days:85,kc:{initial:.4,mid:1,late:.5},drought_tolerance:`High`,suitable_soils:[`Black soil`,`Red soil`,`Loamy`],critical_stages:[`Flowering`,`Pod Formation`],drip_suitable:!0,sprinkler_suitable:!0,recommended_alternative:`Cowpea or Chickpea`,name_kn:`ದ್ವಿದಳ ಧಾನ್ಯಗಳು / ತೊಗರಿ (Pulses / Red Gram)`,alternative_reason:`Short-duration pulses fix nitrogen and require only 2-3 lifesaver irrigations.`}},it={"Black soil":{awc_mm_m:210,evaporation_factor:.85,terracing_suitability:!1,contour_bund_suitable:!1,name_kn:`ಕಪ್ಪು ಮಣ್ಣು (Black Vertisol)`,description:`High water-holding capacity, slow infiltration, prone to deep cracking during dry spells. Terracing not recommended due to swelling/shrinkage.`},"Red soil":{awc_mm_m:120,evaporation_factor:1.1,terracing_suitability:!0,contour_bund_suitable:!0,name_kn:`ಕೆಂಪು ಮಣ್ಣು (Red Sandy Loam)`,description:`Moderate water holding, rapid infiltration, prone to topsoil erosion on slopes. Highly responsive to contour bunding and organic mulching.`},Loamy:{awc_mm_m:150,evaporation_factor:1,terracing_suitability:!0,contour_bund_suitable:!0,name_kn:`ಗೋಡು ಮಣ್ಣು (Loamy Soil)`,description:`Balanced water holding and aeration. Excellent response to both drip and sprinkler micro-irrigation.`},Clay:{awc_mm_m:190,evaporation_factor:.9,terracing_suitability:!0,contour_bund_suitable:!1,name_kn:`ಜೇಡಿ ಮಣ್ಣು (Clay Soil)`,description:`High moisture retention, low permeability. Care required to prevent waterlogging; ideal for alternate furrow irrigation.`},Sandy:{awc_mm_m:80,evaporation_factor:1.25,terracing_suitability:!1,contour_bund_suitable:!0,name_kn:`ಮರಳು ಮಣ್ಣು (Sandy Soil)`,description:`Low water retention, high percolation loss, fast surface drying. Requires frequent micro-doses of drip irrigation and heavy mulch.`}},at=[{name:`Krishi Bhagya Scheme (ಕೃಷಿ ಭಾಗ್ಯ ಯೋಜನೆ)`,name_kn:`ಕೃಷಿ ಭಾಗ್ಯ ಯೋಜನೆ`,department:`Department of Agriculture, Govt. of Karnataka`,benefits:`Financial assistance (80% to 90% subsidy for SC/ST, up to 70% for General) for construction of farm ponds (Krishi Honda), polythene sheet lining, diesel/solar pump sets, and shade net fencing.`,eligibility:`Rain-fed dryland agricultural landholders in notified drought-prone districts of North Karnataka.`,official_url:`https://raitamitra.karnataka.gov.in`},{name:`PMKSY - Per Drop More Crop (ಸೂಕ್ಷ್ಮ ನೀರಾವರಿ ಸಹಾಯಧನ)`,name_kn:`ಪ್ರಧಾನಮಂತ್ರಿ ಕೃಷಿ ಸಿಂಚಾಯಿ ಯೋಜನೆ - ಹನಿ/ತುಂತುರು ನೀರಾವರಿ`,department:`Horticulture & Agriculture Dept, Govt. of Karnataka`,benefits:`Up to 90% subsidy for Small/Marginal Farmers (up to 2 hectares) and 45-55% for other farmers for installing Drip or Sprinkler irrigation systems.`,eligibility:`Farmers with verified borewell, open well, or assured water connection with valid RTC / Pahani document registered in DBT Karnataka portal.`,official_url:`https://dbt.karnataka.gov.in`},{name:`Samrakshane (PMFBY Crop Insurance / ಸಂರಕ್ಷಣೆ ಬೆಳೆ ವಿಮೆ)`,name_kn:`ಸಂರಕ್ಷಣೆ - ಪ್ರಧಾನಮಂತ್ರಿ ಫಸಲ್ ಬಿಮಾ ಯೋಜನೆ`,department:`Karnataka State Agricultural Insurance Portal (Samrakshane)`,benefits:`Crop loss compensation against localized calamities, mid-season drought adversity, prevented sowing, and post-harvest losses.`,eligibility:`Notified crop growers (both loanee and non-loanee farmers) enrolled during the notified cutoff window.`,official_url:`https://samrakshane.karnataka.gov.in`},{name:`Jalamrutha & MGNREGS Watershed Development`,name_kn:`ಜಲಾಮೃತ ಮತ್ತು ನರೇಗಾ ಜಲಾನಯನ ಅಭಿವೃದ್ಧಿ`,department:`Rural Development and Panchayat Raj (RDPR), Karnataka`,benefits:`Community soil and water conservation works: check dams, contour bunding, percolation tanks, recharge pits, and desilting of village tanks without individual capital outlay.`,eligibility:`Gram Panchayat level farmers and dryland agricultural laborers.`,official_url:`https://rdpr.karnataka.gov.in`}],ot=[{id:`scenario_a`,title:`Scenario A: Borewell + Limited Reserve`,title_kn:`ಸನ್ನಿವೇಶ ಎ: ಬೋರ್‌ವೆಲ್ + ಸೀಮಿತ ನೀರಿನ ಸಂಗ್ರಹ`,district:`Vijayapura`,crop:`Cotton`,land_size:3.5,land_unit:`acres`,soil_type:`Black soil`,water_source:`Borewell`,water_reserve_liters:35e4,growth_stage:`Vegetative`,season:`Kharif`,current_method:`Flood / Furrow`,desc:`Deep black soil farmer with dipping borewell output needing to stretch 3.5 lakh liters through critical flowering and boll development.`},{id:`scenario_b`,title:`Scenario B: Rain-fed Dryland Farmer`,title_kn:`ಸನ್ನಿವೇಶ ಬಿ: ಮಳೆಯಾಶ್ರಿತ ಒಣಭೂಮಿ ರೈತ`,district:`Kalaburagi`,crop:`Pulses`,land_size:4,land_unit:`acres`,soil_type:`Red soil`,water_source:`Rain-fed`,water_reserve_liters:0,growth_stage:`Initial / Seedling`,season:`Kharif`,current_method:`Rain-fed`,desc:`Red Gram dryland farmer experiencing irregular monsoon rain; relies on in-situ moisture retention, contour bunding, and weather postponement.`},{id:`scenario_c`,title:`Scenario C: Canal Irrigated Heavy Clay`,title_kn:`ಸನ್ನಿವೇಶ ಸಿ: ಕಾಲುವೆ ನೀರಾವರಿ ಮತ್ತು ಜೇಡಿ ಮಣ್ಣು`,district:`Bagalkot`,crop:`Sugarcane`,land_size:2,land_unit:`acres`,soil_type:`Clay`,water_source:`Canal`,water_reserve_liters:7e5,growth_stage:`Vegetative`,season:`Kharif`,current_method:`Flood / Furrow`,desc:`Canal rotational release creates intermittent water supply followed by 25-day dry intervals. Needs alternate furrow and trash mulching.`},{id:`scenario_d`,title:`Scenario D: Krishi Honda (Farm Pond) Storage`,title_kn:`ಸನ್ನಿವೇಶ ಡಿ: ಕೃಷಿ ಹೊಂಡ ಸಂಗ್ರಹ`,district:`Dharwad`,crop:`Maize`,land_size:2.5,land_unit:`acres`,soil_type:`Loamy`,water_source:`Farm pond`,water_reserve_liters:45e4,growth_stage:`Flowering / Tasseling`,season:`Kharif`,current_method:`Furrow`,de