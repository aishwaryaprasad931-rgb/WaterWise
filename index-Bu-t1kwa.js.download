 நிலத்தின் ${t.crop} பயிர், நீர் சேமிப்பு மற்றும் வானிலை அடிப்படையில் நான் உதவ முடியும். நீங்கள் மைக் அழுத்தி பேசலாம்.`:n===`ml`?`നമസ്കാരം ${t.name}! ഞാൻ നിങ്ങളുടെ വാട്ടർവൈസ് കാർഷിക AI അസിസ്റ്റന്റാണ്. നിങ്ങളുടെ ${t.district} കൃഷിയിടത്തിലെ ${t.crop} വിള, ജല ശേഖരം, കാലാവസ്ഥ എന്നിവ അടിസ്ഥാനമാക്കി ഞാൻ സഹായിക്കാം. നിങ്ങൾക്ക് മൈക്ക് അമർത്തി സംസാരിക്കാം.`:`Hello ${t.name}! I am your WaterWise Farm AI Assistant. I have access to your verified farm records for ${t.crop} in ${t.district} (${(t.water_reserve_liters/1e3).toLocaleString(`en-IN`)}k L reserve). You can type or tap the microphone to speak your question.`,timestamp:new Date().toLocaleTimeString([],{hour:`2-digit`,minute:`2-digit`}),data_grounding:`Grounded in ${t.crop} (${t.land_size} ac) in ${t.district}`}]),[s,c]=(0,w.useState)(``),[l,u]=(0,w.useState)(!1),[d,f]=(0,w.useState)(!1),[p,m]=(0,w.useState)(null),[h,g]=(0,w.useState)(null),[_,v]=(0,w.useState)(()=>{try{return localStorage.getItem(`waterwise_auto_speak`)===`true`}catch{return!1}}),y=(0,w.useRef)(null),b=(0,w.useRef)(null),x=(0,w.useRef)(null),S=BB(),C=VB();(0,w.useEffect)(()=>{y.current?.scrollIntoView({behavior:`smooth`})},[a,l,d]),(0,w.useEffect)(()=>()=>{WB(),x.current?.(),b.current?.stop()},[n]);let T=()=>{let e=!_;v(e);try{localStorage.setItem(`waterwise_auto_speak`,String(e))}catch{}e||(WB(),g(null))},E=()=>{if(d){b.current?.stop(),f(!1);return}if(!S){m(r.voiceNotSupported),setTimeout(()=>m(null),5e3);return}m(null),WB(),g(null);let e=GB({lang:n,onStart:()=>{f(!0)},onResult:(e,t)=>{c(e),t&&f(!1)},onError:e=>{m(e),f(!1),setTimeout(()=>m(null),5e3)},onEnd:()=>{f(!1)}});b.current=e,e.start()},D=(e,t)=>{if(h===e){WB(),g(null);return}WB(),g(e);let r=UB(t,n,()=>{g(e)},()=>{g(null)},e=>{console.warn(`TTS error:`,e),g(null)});x.current=r},O=async t=>{let r=t||s;if(!r.trim()||l)return;d&&(b.current?.stop(),f(!1));let i={id:`user_${Date.now()}`,sender:`user`,text:r.trim(),timestamp:new Date().toLocaleTimeString([],{hour:`2-digit`,minute:`2-digit`})};o(e=>[..