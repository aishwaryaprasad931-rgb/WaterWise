/50 text-gray-900`,children:[(0,I.jsx)(`option`,{value:`normal`,children:o.normalWeather}),(0,I.jsx)(`option`,{value:`dry_spell`,children:o.drySpell}),(0,I.jsx)(`option`,{value:`near_drought`,children:o.nearDrought})]})]})]}),(0,I.jsxs)(`div`,{className:`pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-gray-100`,children:[(0,I.jsxs)(`div`,{className:`flex items-center space-x-2 text-[11px] text-gray-500`,children:[(0,I.jsx)(le,{className:`w-4 h-4 text-[#40916c]`}),(0,I.jsx)(`span`,{children:o.faoFormulaNote})]}),(0,I.jsxs)(`button`,{type:`submit`,disabled:n,className:`w-full sm:w-auto bg-[#1b4332] hover:bg-[#2d6a4f] text-white font-bold text-xs py-2.5 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2 shadow-sm disabled:opacity-50 cursor-pointer`,children:[(0,I.jsx)(A,{className:`w-4 h-4`}),(0,I.jsx)(`span`,{children:n?o.analyzing:o.generatePlan})]})]})]})]})},ht=({farmerProfile:e,calculations:t,weather:n,droughtData:r,lang:i,onNavigateTab:a})=>{P[i]||P.en;let o=!!r?.is_drought_active,s=t.deficit_or_surplus_liters<0,c=e.current_method.toLowerCase().includes(`flood`),l=F(e.crop,i),u=F(e.district,i),d=F(e.soil_type,i),f=F(e.growth_stage||`Vegetative`,i),p=()=>{let t=(e.soil_type||``).toLowerCase();return t.includes(`black`)?{title:i===`kn`?`ಕಪ್ಪು ಮಣ್ಣಿನ (ರೆಗೂರ್) ಸಂರಕ್ಷಣೆ`:i===`hi`?`काली मिट्टी (रेगुर) नमी संरक्षण`:i===`te`?`నల్లరేగడి నేల తేమ రక్షణ`:i===`ta`?`கரிசல் மண் ஈரப்பதப் பாதுகாப்பு`:i===`ml`?`കറുത്ത മണ്ണിലെ ഈർപ്പ സംരക്ഷണം`:`Black Soil (Vertisol) Moisture Retention`,action:i===`kn`?`ಬಿರುಕುಗಳಿಂದ ಆವಿಯಾಗುವುದನ್ನು ತಡೆಯಲು 5 ಸೆಂ.ಮೀ ಕಳೆ/ರಾಗಿ ಹೊಟ್ಟು ಹೊದಿಕೆ (ಮಲ್ಚಿಂಗ್) ಮಾಡಿ.`:i===`hi`?`गहरी दरारों से होने वाले 35% वाष्पीकरण को रोकने के लिए 5 सेमी अवशेष मल्चिंग करें।`:i===`te`?`నేలలో పగుళ్ల ద్వారా తేమ ఆవిరి కాకుండా 5 సెం.మీ వ్యర్థాలతో మల్చింగ్ చేయండి.`:i===`ta`?`வெடிப்புகள் மூலம் ஈரப்பதம் வீணாவதை தடுக்க 5 செ.மீ மூடாக்கு இடவும்.`:i===`ml`?`വിള്ളലിലൂടെ ഈർപ്പം നഷ്ടപ്പെടുന്നത് തടയാൻ 5 സെ.മീ പുതയിടൽ (മൾച്ചിംഗ്) നടത്തുക.`:`Seal surface micro-cracks with 5cm organic residue mulch to prevent 35% deep evaporation loss.`}:t.includes(`red`)?{title:i===`kn`?`ಕೆಂಪು ಮಣ್ಣಿನ ತುಂತುರು/ಹನಿ ನಿರ್ವಹಣೆ`:i===`hi`?`लाल मिट्टी ड्रिप सिंचाई प्रबंधन`:i===`te`?`ఎర్ర నేల బిందు సేద్య యాజమాన్యం`:i===`ta`?`செம்மண் சொட்டு நீர் மேலாண்மை`:i===`ml`?`ചുവന്ന മണ്ണിലെ തുള്ളിനന`:`Red Soil Percolation Control`,action:i===`kn`?`ಕೆಂಪು ಮಣ್ಣಿನಲ್ಲಿ ನೀರು ವೇಗವಾಗಿ ಜಿನುಗುವುದರಿಂದ, ದಿನಕ್ಕೆ 2 ಬಾರಿ ಅಲ್ಪಾವಧಿ ಹನಿ ನೀರಾವರಿ ನೀಡಿ.`:i===`hi`?`तेज रिसाव रोकने के लिए एक बार में लंबा पानी देने के बजाय 2 बार संक्षिप्त ड्रिप चलाएं।`:i===`te`?`నీరు త్వరగా ఇంకిపోకుండా ఒకేసారి కాకుండా రోజుకు 2 సార్లు తక్కువ సమయం నీరు అందించండి.`:i===`ta`?`நீர்க் கசிவை தவிர்க்க ஒரே நேரத்தில் பாய்ச்சாமல் 2 முறை சுருக்கமான நீர் பாய்ச்சவும்.`:i===`ml`?`വെള്ളം താഴ്ന്നുപോകാതിരിക്കാൻ ദിവസത്തിൽ 2 തവണയായി കുറഞ്ഞ സമയം നനയ്ക്കുക.`:`Prevent root-zone leaching by switching from single deep flooding to 2 pulsed drip cycles daily.`}:{title:i===`kn`?`ಮಣ್ಣಿನ ತೇವಾಂಶ ನಿರ್ವಹಣೆ`:i===`hi`?`मृदा नमी प्रबंधन`:i===`te`?`నేల తేమ యాజమాన్యం`:i===`ta`?`மண் ஈரப்பதம் மேலாண்மை`:i===`ml`?`മണ്ണിലെ ഈർപ്പ സംരക്ഷണം`:`Soil Moisture Conservation`,action:i===`kn`?`ಸಾವಯವ ಹೊದಿಕೆ ಮತ್ತು ಅಂತರ-ಬೇಸಾಯದಿಂದ ತೇವಾಂಶ ಸಂರಕ್ಷಿಸಿ.`:i===`hi`?`जैविक मल्चिंग और अंतर-सस्यन से भूमि में नमी संचित रखें।`:i===`te`?`సేంద్రీయ మల్చింగ్ మరియు అంతర సాగు ద్వారా తేమను కాపాడండి.`:i===`ta`?`இயற்கை மூடாக்கு மற்றும் இடை உழவு மூலம் ஈரப்பதத்தை சேமிக்கவும்.`:i===`ml`?`ജൈവ പുതയിടലും ഇടയിളക്കലും വഴി മണ്ണിലെ ഈർപ്പം നിലനിർത്തുക.`:`Apply inter-row dust mulch and organic cover to preserve root-zone moisture.`}},m=()=>{let t=(e.growth_stage||``).toLowerCase();return(e.crop||``).toLowerCase(),t.includes(`flower`)||t.includes(`tassel`)||t.includes(`bloom`)?{badge:i===`kn`?`ಅತ್ಯಂತ ಸೂಕ್ಷ್ಮ ಹಂತ!`:i===`hi`?`अत्यंत संवेदनशील अवस्था!`:i===`te`?`కీలకమైన పూత దశ!`:i===`ta`?`முக்கிய பூக்கும் நிலை!`:i===`ml`?`നിർണായക പൂവിടൽ ഘട്ടം!`:`CRITICAL SENSITIVE STAGE!`,desc:i===`kn`?`${l} ಹೂವಾಡುವ ಹಂತದಲ್ಲಿದೆ. ನೀರಿನ ಕೊರತೆಯಿಂದ ಕಾಯಿ/ಹೂವು ಉದುರುವುದನ್ನು ತಡೆಯಲು ಇರುವ ನೀರಿನಲ್ಲಿ 45% ಮೀಸಲಿಡಿ.`:i===`hi`?`${l} फूल आने की अवस्था में है। फूल झड़ने से रोकने के लिए अपने जल भंडार का 45% विशेष रूप से इसी अवस्था के लिए बचाएं।`:i===`te`?`${l} పూత దశలో ఉంది. పూత రాలకుండా ఉండేందుకు మీ నీటి నిల్వలో 45% ఈ దశకే కేటాయించండి.`:i===`ta`?`${l} பூக்கும் நிலையில் உள்ளது. பூக்கள் உதிர்வதைத் தவிர்க்க நீர் இருப்பில் 45% இந்த நிலைக்கே ஒதுக்குங்கள்.`:i===`ml`?`${l} പൂവിടുന്ന ഘട്ടത്തിലാണ്. പൂക്കൾ കൊഴിയാതിരിക്കാൻ ബാക്കി വെള്ളത്തിന്റെ 45% ഈ ഘട്ടത്തിനായി കരുതിവെക്കുക.`:`${l} is in reproductive flowering. Water stress now causes up to 45% yield drop; reserve 45% of available water strictly for this phase.`}:t.includes(`seed`)||t.includes(`initial`)?{badge:i===`kn`?`ಮೊಳಕೆ ಹಂತ`:i===`hi`?`अंकुरण अवस्था`:i===`te`?`మొలక దశ`:i===`ta`?`முளைக்கும் நிலை`:i===`ml`?`മുളയ്ക്കുന്ന ഘട്ടം`:`SEEDLING STAGE`,desc:i===`kn`?`ಲಘು ನೀರಾವರಿ ನೀಡಿ, ಬೇರುಗಳು ಕೊಳೆಯದಂತೆ ಅಧಿಕ ನೀರು ನಿಲ್ಲಿಸಬೇಡಿ.`:i===`hi`?`हल्की सिंचाई करें, अत्यधिक जलभराव से बचें ताकि कोमल जड़ें न गलें।`:i===`te`?`తేలికపాటి తడులు ఇవ్వండి, వేర్లు కుళ్ళిపోకుండా అధిక నీరు నిల్వ ఉండకుండా చూడండి.`:i===`ta`?`லேசான பாசனம் செய்யுங்கள், வேர் அழுகலைத் தடுக்க அதிக நீர் தேங்க விடாதீர்கள்.`:i===`ml`?`ലഘുവായ നനവ് നൽകുക, വേരുകൾ ചീയാതിരിക്കാൻ വെള്ളം കെട്ടിക്കിടക്കാൻ അനുവദിക്കരുത്.`:`Provide light, uniform moisture; avoid standing water to protect shallow tender root systems.`}:{badge:i===`kn`?`ಬೆಳವಣಿಗೆ ಹಂತ`:i===`hi`?`सक्रिय वृद्धि अवस्था`:i===`te`?`శాకీయ పెరుగుదల దశ`:i===`ta`?`வளர்ச்சி நிலை`:i===`ml`?`വളർച്ചാ ഘട്ടം`:`VEGETATIVE PHASE`,desc:i===`kn`?`ಬೆಳೆಯ ಕಾಯಿಗೆ ಮತ್ತು ಎಲೆಗಳಿಗೆ ಸರಿಯಾದ ಅಂತರದಲ್ಲಿ ನೀರು ಒದಗಿಸಿ.`:i===`hi`?`नियमित अंतराल पर संतुलित सिंचाई दें ताकि वानस्पतिक विकास सुदृढ़ हो।`:i===`te`?`మొక్క సమతుల్య పెరుగుదలకు నిర్ణీత వ్యవధిలో నీరు అందించండి.`:i===`ta`?`சீரான இடைவெளியில் சீரான பாசனம் அளிக்கவும்.`:i===`ml`?`ചെടിയുടെ ശരിയായ വളർച്ചയ്ക്കായി നിശ്ചിത ഇടവേളകളിൽ നനയ്ക്കുക.`:`Maintain steady root-zone moisture at calibrated intervals to build strong vegetative frame.`}},h=()=>c?{name:i===`kn`?`ಪಿಎಂಕೆಎಸ್‌ವೈ ಹನಿ ನೀರಾವರಿ ಯೋಜನೆ (PMKSY - Raitha Mitra)`:i===`hi`?`पीएमकेएसवाई ड्रिप सिंचाई सब्सिडी (PMKSY Scheme)`:i===`te`?`పీఎంకేఎస్వై బిందు సేద్య పథకం (PMKSY Scheme)`:i===`ta`?`பி.எம்.கே.எஸ்.ஒய் சொட்டு நீர் திட்டம் (PMKSY Scheme)`:i===`ml`?`പിഎംകെഎസ്വൈ തുള്ളിനന പദ്ധതി (PMKSY Scheme)`:`PMKSY Per Drop More Crop (Micro-Irrigation)`,subsidy:`70% – 90% Subsidy`,portal:`raitamitra.karnataka.gov.in`,portalUrl:`https://raitamitra.karnataka.gov.in`,action:i===`kn`?`ನಿಮ್ಮ ${e.land_size} ಎಕರೆ ಜಮೀನಿಗೆ ಹನಿ ನೀರಾವರಿ ಅಳವಡಿಸಲು ರೈತ ಸಂಪರ್ಕ ಕೇಂದ್ರ ಅಥವಾ ರೈತ ಮಿತ್ರ ಪೋರ್ಟಲ್‌ನಲ್ಲಿ ಅರ್ಜಿ ಸಲ್ಲಿಸಿ.`:i===`hi`?`अपनी ${e.land_size} एकड़ जमीन पर ड्रिप लगाने के लिए 90% तक सब्सिडी हेतु रैता मित्र पोर्टल पर आवेदन करें।`:i===`te`?`మీ ${e.land_size} ఎకరాలలో డ్రిప్ ఏర్పాటుకు 90% సబ్సిడీ కోసం రైతా మిత్ర పోర్టల్‌లో దరఖాస్తు చేయండి.`:i===`ta`?`உங்கள் ${e.land_size} ஏக்கர் நிலத்தில் சொட்டு நீர் அமைக்க 90% மானியத்திற்கு ரைதா மித்ரா போர்ட்டலில் விண்ணப்பிக்கவும்.`:i===`ml`?`നിങ്ങളുടെ ${e.land_size} ഏക്കർ സ്ഥലത്ത് തുള്ളിനന സ്ഥാപിക്കാൻ 90% സബ്സിഡിക്കായി റൈത്ത മിത്ര പോർട്ടലിൽ അപേക്ഷിക്കുക.`:`Apply on Raitha Mitra portal for up to 90% subsidy to convert your ${e.land_size} acres to drip.`}:e.water_source.toLowerCase().includes(`borewell`)||s?{name:i===`kn`?`ಕೃಷಿ ಭಾಗ್ಯ ಯೋಜನೆ (ಕೃಷಿ ಹೊಂಡ + ಸೋಲಾರ್ ಪಂಪ್)`:i===`hi`?`कृषि भाग्य योजना (खेत तालाब + पंप सब्सिडी)`:i===`te`?`కృషి భాగ్య పథకం (ఫామ్ పాండ్ సబ్సిడీ)`:i===`ta`?`கிருஷி பாக்யா திட்டம் (பண்ணை குட்டை)`:i===`ml`?`കൃഷി ഭാഗ്യ പദ്ധതി (കൃഷിത്തോട്ട കുളം)`:`Krishi Bhagya Dryland Scheme (Farm Pond & Solar Pump)`,subsidy:`80% – 90% Subsidy`,portal:`watershed.karnataka.gov.in`,portalUrl:`https://watershed.karnataka.gov.in`,action:i===`kn`?`${u} ಜಿಲ್ಲೆಯ ಒಣಭೂಮಿ ರೈತರಿಗೆ ಕೃಷಿ ಹೊಂಡ ನಿರ್ಮಾಣ ಮತ್ತು ಪಾಲಿಥಿನ್ ಲೈನಿಂಗ್‌ಗೆ ಶೇ.80-90 ಧನಸಹಾಯ.`:i===`hi`?`${u} जिले में खेत तालाब और पॉलीथिन लाइनिंग निर्माण हेतु 80-90% सरकारी सहायता प्राप्त करें।`:i===`te`?`${u} జిల్లాలోని మెట్ట రైతులకు వ్యవసాయ కుంట నిర్మాణం కోసం 80-90% సబ్సిడీ లభిస్తుంది.`:i===`ta`?`${u} மாவட்ட விவசாயிகளுக்கு பண்ணை குட்டை அமைக்க 80-90% நிதி உதவி.`:i===`ml`?`${u} ജില്ലയിലെ കർഷകർക്ക് ഫാം പോണ്ട് നിർമ്മിക്കാൻ 80-90% സാമ്പത്തിക സഹായം.`:`80-90% grant to construct a lined farm pond to store rainwater and secure life-saving irrigation in ${u}.`}:{name:i===`kn`?`ಪ್ರಧಾನ ಮಂತ್ರಿ ಫಸಲ್ ಬಿಮಾ ಯೋಜನೆ (Samrakshane)`:i===`hi`?`पीएम फसल बीमा योजना (संरक्षण पोर्टल)`:i===`te`?`పీఎం ఫసల్ బీమా యోజన (సంరక్షణ పోర్టల్)`:i===`ta`?`பிரதம மந்திரி பயிர் காப்பீட்டு திட்டம் (சம்ரக்ஷனே)`:i===`ml`?`പ്രധാനമന്ത്രി ഫസൽ ഭീമ യോജന (സംരക്ഷണം)`:`PMFBY Crop Insurance & Drought Relief (Samrakshane Portal)`,subsidy:`Full Risk Cover`,portal:`samrakshane.karnataka.gov.in`,portalUrl:`https://samrakshane.karnataka.gov.in`,action:i===`kn`?`ಬೆಳೆ ನಷ್ಟ ಅಥವಾ ಮಳೆ ಕೊರತೆ ಉಂಟಾದರೆ 72 ಗಂಟೆಗಳಲ್ಲಿ ಸಂರಕ್ಷಣೆ ಪೋರ್ಟಲ್‌ನಲ್ಲಿ ದೂರು ದಾಖಲಿಸಿ.`:i===`hi`?`बारिश की कमी या फसल क्षति की स्थिति में 72 घंटों के भीतर संरक्षण पोर्टल पर नुकसान दर्ज कराएं।`:i===`te`?`వర్షభావం లేదా పంట నష్టం జరిగితే 72 గంటల్లో సంరక్షణ పోర్టల్‌లో నమోదు చేయండి.`:i===`ta`?`மழை குறைவு அல்லது பயிர் சேதம் ஏற்பட்டால் 72 மணி நேரத்திற்குள் சம்ரக்ஷனே போர்ட்டலில் பதிவு செய்யவும்.`:i===`ml`?`മഴക്കുറവോ വിളനാശമോ ഉണ്ടായാൽ 72 മണിക്കൂറിനകം സംരക്ഷൺ പോർട്ടലിൽ വിവരം രേഖപ്പെടുത്തുക.`:`Report local drought distress within 72 hours on Samrakshane portal for immediate compensation.`},g=p(),_=m(),v=h(),y=t.savings_with_drip_mulch_liters;return(0,I.jsxs)(`div`,{className:`bg-gradient-to-br from-[#163824] via-[#1b4332] to-[#2d6a4f] text-white rounded-2xl p-5 sm:p-6 shadow-md border border-[#40916c]/40 space-y-5`,children:[(0,I.jsxs)(`div`,{className:`flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-white/15 gap-3`,children:[(0,I.jsxs)(`div`,{className:`space-y-1`,children:[(0,I.jsxs)(`div`,{className:`flex items-center space-x-2`,children:[(0,I.jsx)(`span`,{className:`bg-[#52b788] text-[#081c15] text-[10px] font-extrabold uppercase px-2 py-0.5 rounded tracking-wide`,children:i===`kn`?`ವೈಯಕ್ತಿಕ ಕೃಷಿ ಸಲಹೆ`:i===`hi`?`व्यक्तिगत कृषि सलाह`:i===`te`?`వ్యక్తిగత వ్యవసాయ సలహా`:i===`ta`?`தனிப்பயன் விவசாய ஆலோசனை`:i===`ml`?`വ്യക്തിഗത കാർഷിക നിർദ്ദേശം`:`Pe