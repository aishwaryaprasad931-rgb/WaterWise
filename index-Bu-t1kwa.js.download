9,rain_mm:0},{day:-8,rain_mm:0},{day:-7,rain_mm:0},{day:-6,rain_mm:0},{day:-5,rain_mm:0},{day:-4,rain_mm:0},{day:-3,rain_mm:0},{day:-2,rain_mm:0},{day:-1,rain_mm:0}],forecast_14_days:[{day:1,rain_mm:0,rain_probability_pct:2,tmax_c:39.6,tmin_c:24.4,et0_mm:7.4},{day:2,rain_mm:0,rain_probability_pct:4,tmax_c:40.2,tmin_c:26.3,et0_mm:7.7},{day:3,rain_mm:0,rain_probability_pct:4,tmax_c:40.9,tmin_c:25.1,et0_mm:6.5},{day:4,rain_mm:0,rain_probability_pct:6,tmax_c:38.7,tmin_c:26.7,et0_mm:6.7},{day:5,rain_mm:0,rain_probability_pct:3,tmax_c:40.7,tmin_c:24.7,et0_mm:7},{day:6,rain_mm:0,rain_probability_pct:3,tmax_c:39.1,tmin_c:26.2,et0_mm:8},{day:7,rain_mm:0,rain_probability_pct:5,tmax_c:40,tmin_c:24.2,et0_mm:7.4},{day:8,rain_mm:0,rain_probability_pct:4,tmax_c:41,tmin_c:24.9,et0_mm:6.6},{day:9,rain_mm:0,rain_probability_pct:0,tmax_c:38.4,tmin_c:24.4,et0_mm:7.2},{day:10,rain_mm:0,rain_probability_pct:3,tmax_c:40.9,tmin_c:25.2,et0_mm:6.8},{day:11,rain_mm:0,rain_probability_pct:2,tmax_c:40.9,tmin_c:24.6,et0_mm:6.6},{day:12,rain_mm:0,rain_probability_pct:3,tmax_c:40.2,tmin_c:24.6,et0_mm:6.6},{day:13,rain_mm:0,rain_probability_pct:3,tmax_c:39,tmin_c:26.3,et0_mm:7.4},{day:14,rain_mm:0,rain_probability_pct:4,tmax_c:40.6,tmin_c:26.7,et0_mm:6.8}]}]},vV=[{method_id:`M01`,method:`Drip irrigation`,method_type:`irrigation_system`,description:`Water delivered slowly at the root zone through pipes and emitters`,suitable_crops:[`tomato`,`cotton`,`maize`,`groundnut`,`tur`],suitable_soils:[`all`,`black`,`red`,`sandy`,`loamy`,`clay`],water_source_fit:[`any`,`borewell`,`open_well`,`canal`,`farm_pond`],saving_pct_min:30,saving_pct_max:50,cost_level:`high`,setup_difficulty:`medium`,best_for_situation:`Limited water and a high-value or row crop`,notes:`Subsidy is often available (70%-90% PMKSY); verify the current scheme before quoting`},{method_id:`M02`,method:`Sprinkler irrigation`,method_type:`irrigation_system`,description:`Water sprayed over the crop through pipes and nozzles`,suitable_crops:[`groundnut`,`maize`,`jowar`,`ragi`,`tur`],suitable_soils:[`red`,`sandy`,`loamy`],water_source_fit:[`any`,`borewell`,`open_well`,`canal`],saving_pct_min:20,saving_pct_max:35,cost_level:`medium`,setup_difficulty:`low`,best_for_situation:`Undulating or light soils where flooding wastes water`,notes:`Less suitable in strong wind`},{method_id:`M03`,method:`Organic mulching with crop residue`,method_type:`soil_moisture`,description:`Spread dry residue on soil to cut evaporation`,suitable_crops:[`all`,`cotton`,`maize`,`jowar`,`tur`,`groundnut`,`tomato`,`ragi`,`paddy`],suitable_soils:[`all`,`black`,`red`,`sandy`,`loamy`],water_source_fit:[`any`,`borewell`,`canal`,`rainfed`],saving_pct_min:15,saving_pct_max:30,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Any crop where residue is available`,notes:`Cheapest quick step; also reduces weeds`},{method_id:`M04`,method:`Plastic mulch`,method_type:`soil_moisture`,description:`Plastic film laid on beds to cut evaporation`,suitable_crops:[`tomato`,`cotton`,`groundnut`],suitable_soils:[`all`,`black`,`red`,`loamy`],water_source_fit:[`any`,`borewell`],saving_pct_min:25,saving_pct_max:40,cost_level:`medium`,setup_difficulty:`medium`,best_for_situation:`Row crops with drip`,notes:`Film disposal needs care`},{method_id:`M05`,method:`Schedule irrigation around the rain forecast`,method_type:`scheduling`,description:`Skip or delay irrigation when useful rain is forecast soon`,suitable_crops:[`all`,`cotton`,`maize`,`jowar`,`tur`,`groundnut`,`tomato`,`ragi`,`paddy`],suitable_soils:[`all`],water_source_fit:[`any`],saving_pct_min:10,saving_pct_max:25,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Any farmer with access to a forecast`,notes:`Uses forecast data; no equipment needed`},{method_id:`M06`,method:`Critical-stage (deficit) irrigation`,method_type:`scheduling`,description:`Give scarce water mainly at the stages the crop is most sensitive`,suitable_crops:[`maize`,`jowar`,`ragi`,`cotton`,`groundnut`,`tur`],suitable_soils:[`all`],water_source_fit:[`borewell`,`canal`,`farm_pond`,`open_well`],saving_pct_min:15,saving_pct_max:30,cost_level:`low`,setup_difficulty:`medium`,best_for_situation:`Fixed water reserve that cannot cover the whole season`,notes:`See critical stages in crop_water_need benchmark`},{method_id:`M07`,method:`Alternate wetting and drying`,method_type:`irrigation_practice`,description:`Let the field dry briefly between irrigations instead of keeping it flooded`,suitable_crops:[`paddy`,`rice`],suitable_soils:[`black`,`red`,`loamy`,`clay`],water_source_fit:[`canal`,`borewell`],saving_pct_min:15,saving_pct_max:30,cost_level:`low`,setup_difficulty:`medium`,best_for_situation:`Paddy with controlled water supply`,notes:`Needs a perforated field pipe to check the water level`},{method_id:`M08`,method:`Direct seeded rice`,method_type:`crop_practice`,description:`Sow paddy seed directly instead of transplanting seedlings`,suitable_crops:[`paddy`,`rice`],suitable_soils:[`black`,`red`,`loamy`],water_source_fit:[`any`,`canal`,`borewell`,`rainfed`],saving_pct_min:20,saving_pct_max:30,cost_level:`low`,setup_difficulty:`medium`,best_for_situation:`Paddy where water for puddling and nursery is short`,notes:`Weed control is more important`},{method_id:`M09`,method:`Farm pond`,method_type:`water_harvesting`,description:`Dug pond that stores runoff for protective irrigation`,suitable_crops:[`all`],suitable_soils:[`all`,`black`,`red`,`clay`],water_source_fit:[`rainfed`,`canal`],saving_pct_min:0,saving_pct_max:0,cost_level:`high`,setup_difficulty:`medium`,best_for_situation:`Rain-fed farms with runoff to capture`,notes:`Stores water rather than saving it; saving shown as 0%`},{method_id:`M10`,method:`Contour bunding`,method_type:`land_solution`,description:`Low earth bunds along the contour that slow runoff and hold moisture`,suitable_crops:[`all`],suitable_soils:[`red`,`black`,`sandy`],water_source_fit:[`rainfed`],saving_pct_min:10,saving_pct_max:25,cost_level:`low`,setup_difficulty:`medium`,best_for_situation:`Gentle to moderate slopes on rain-fed land`,notes:`Needs a slope survey`},{method_id:`M11`,method:`Terracing (step farming)`,method_type:`land_solution`,description:`Level steps cut into a slope to slow runoff and hold soil moisture`,suitable_crops:[`maize`,`ragi`,`groundnut`,`tur`,`jowar`],suitable_soils:[`red`,`sandy`],water_source_fit:[`rainfed`],saving_pct_min:15,saving_pct_max:30,cost_level:`high`,setup_difficulty:`high`,best_for_situation:`Steeper slopes where runoff and erosion are the problem`,notes:`Labour or machine cost is high; often needs support`},{method_id:`M12`,method:`Broad bed and furrow (BBF)`,method_type:`land_solution`,description:`Raised beds with furrows for drainage and moisture storage`,suitable_crops:[`groundnut`,`cotton`,`maize`,`tur`],suitable_soils:[`black`,`clay`],water_source_fit:[`any`],saving_pct_min:10,saving_pct_max:20,cost_level:`medium`,setup_difficulty:`medium`,best_for_situation:`Black soils that waterlog or crack`,notes:`Needs a bed-maker or labour`},{method_id:`M13`,method:`Compartment bunding`,method_type:`land_solution`,description:`Small bunded plots that hold rain in the field`,suitable_crops:[`jowar`,`tur`,`cotton`,`ragi`],suitable_soils:[`black`,`red`],water_source_fit:[`rainfed`],saving_pct_min:10,saving_pct_max:20,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Flat rain-fed fields`,notes:`Quick and cheap to make`},{method_id:`M14`,method:`Conservation tillage or deep ploughing before rains`,method_type:`land_solution`,description:`Open the soil before the rains so more rain soaks in`,suitable_crops:[`all`],suitable_soils:[`black`,`red`],water_source_fit:[`rainfed`],saving_pct_min:5,saving_pct_max:15,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Before the first rains in dry areas`,notes:`Timing matters`},{method_id:`M15`,method:`Switch to a drought-tolerant crop`,method_type:`crop_planning`,description:`Grow ragi, jowar or tur instead of a water-heavy crop`,suitable_crops:[`ragi`,`jowar`,`tur`],suitable_soils:[`all`],water_source_fit:[`any`],saving_pct_min:30,saving_pct_max:60,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Water is too short for the planned crop`,notes:`Saving is relative to the crop replaced, for example paddy or sugarcane or cotton`},{method_id:`M16`,method:`Intercropping`,method_type:`crop_planning`,description:`Grow a short-duration crop between rows of the main crop`,suitable_crops:[`tur`,`jowar`,`groundnut`],suitable_soils:[`all`],water_source_fit:[`rainfed`],saving_pct_min:5,saving_pct_max:15,cost_level:`low`,setup_difficulty:`medium`,best_for_situation:`Rain-fed farms looking to spread risk`,notes:`Mainly spreads risk and shades soil`},{method_id:`M17`,method:`Timely weed control`,method_type:`soil_moisture`,description:`Remove weeds that compete for soil water`,suitable_crops:[`all`],suitable_soils:[`all`],water_source_fit:[`any`],saving_pct_min:5,saving_pct_max:10,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Every farm`,notes:`Cheap and often forgotten`},{method_id:`M18`,method:`Alternate furrow irrigation`,method_type:`irrigation_practice`,description:`Irrigate every second furrow instead of all furrows`,suitable_crops:[`maize`,`cotton`,`tomato`],suitable_soils:[`all`,`black`,`loamy`],water_source_fit:[`canal`,`borewell`],saving_pct_min:15,saving_pct_max:30,cost_level:`low`,setup_difficulty:`low`,best_for_situation:`Furrow-irrigated row crops`,notes:`Works best on level fields`}],yV=[{support_id:`S01`,category:`government_support`,support_type:`Crop insurance claim (PMFBY)`,description:`Farmers enrolled in a crop insurance scheme may be able to claim for crop loss from drought`,when_applicable:`Enrolled farmers whose crop is failing due to seasonal dry spells`,farmer_action_steps:`Check enrolment, inform the insurer or bank within the allowed time (within 72 hours), and keep geotagged photos of the field`,who_to_contact:`District agriculture office or the bank branch that issued the policy`},{support_id:`S02`,category:`government_support`,support_type:`Drought declaration and input relief`,description:`When an area is officially declared drought-affected, relief such as input subsidy may become available`,when_applicable:`Area declared drought-affected by Karnataka State Disaster Management Authority`,farmer_action_steps:`Check whether your taluk is declared; register with the local agriculture office and verify Aadhaar/FID`,who_to_contact:`District agriculture office or taluk office / Raitha Mitra Kendra`},{support_id:`S03`,category:`government_support`,support_type:`Seed or input subsidy for a contingency crop`,description:`Subsidised seed or inputs may be available for a short-duration or drought-tolerant replacement crop`,when_applicable:`Sowing is still possible but the first crop failed or cannot be sown`,farmer_action_steps:`Ask the local agriculture office about contingency seed availability (short-duration jowar, pulses, ragi)`,who_to_contact:`Local agriculture office or Raitha Samparka Kendra`},{support_id:`S04`,category:`government_support`,support_type:`Fodder support`,description:`Fodder or fodder seed support may be arranged for livestock owners in drought`,when_applicable:`Crop is failing and cattle feed/green fodder is short`,farmer_action_steps:`Report fodder shortage to the local office; register cattle at the fodder bank`,who_to_contact:`Animal husbandry office or local gram panchayat`},{support_id:`S05`,category:`government_support`,support_type:`Rural employment support (MGNREGA)`,description:`Wage work through rural employment schemes can help a household in drought`,when_applicable:`Farm income lost to drought`,farmer_action_steps:`Register or renew a job card at the village panchayat for water-harvesting bund/pond excavation work`,who_to_contact:`Village gram panchayat`},{support_id:`S06`,category:`government_support`,support_type:`Loan restructuring or repayment relief`,description:`Banks may allow rescheduling of crop loans in notified drought areas`,when_applicable:`Farmer has a Kisan Credit Card (KCC) / crop loan and the crop has failed`,farmer_action_steps:`Talk to the bank branch early, before the due date, to apply for loan conversion to medium term`,who_to_contact:`Bank branch / Primary Agricultural Credit Society (PACS)`},{support_id:`S07`,category:`government_support`,support_type:`Drinking water and borewell priority`,description:`Local bodies may arrange water for people and livestock in severe shortage`,when_applicable:`Borewell or community tank has dried up`,farmer_action_steps:`Inform the panchayat or taluk office; request tanker supply or borewell deepening assistance`,who_to_contact:`Village panchayat or taluk office`},{support_id:`P01`,category:`practical_step`,support_type:`Protect the critical stage first`,description:`Use the remaining water only for the stage the crop is most sensitive to, such as flowering`,when_applicable:`Very little water left in reserve (< 30% of seasonal requirement)`,farmer_action_steps:`Stop irrigating vegetative non-critical stages and keep the reserve locked for flowering and grain set`,who_to_contact:`Not applicable (Field Practice)`},{support_id:`P02`,category:`practical_step`,support_type:`Thin the crop`,description:`Reduce the number of plants so the remaining ones get more of the limited water`,when_applicable:`Water cannot support the full plant population`,farmer_action_steps:`Remove weaker plants in rows or alternate plants to cut transpiration by 30%-40%`,who_to_contact:`Not applicable (Field Practice)`},{support_id:`P03`,category:`practical_step`,support_type:`Mulch and weed`,description:`Cover soil with residue and clear weeds so no water is lost to evaporation or weeds`,when_applicable:`Any dry spell or moisture stress condition`,farmer_action_steps:`Spread dry crop residue (5-8 cm) around plants and weed regularly to halt moisture stealing`,who_to_contact:`Not applicable (Field Practice)`},{support_id:`P04`,category:`practical_step`,support_type:`Salvage the crop as fodder`,description:`If the crop will not reach grain, cutting it for fodder can recover some value`,when_applicable:`Crop is failing before grain set with water reserve completely exhausted`,farmer_action_steps:`Cut at milk stage or before drying; sell or store as high-protein green cattle fodder`,who_to_contact:`Not applicable (Field Practice)`},{support_id:`P05`,category:`practical_step`,support_type:`Short-duration replacement crop`,description:`Switch to a short-duration, drought-tolerant crop if sowing is still possible`,when_applicable:`Early in the season and rain is not coming, or initial sowing failed`,farmer_action_steps:`Talk to the agriculture office for suitable seed (horsegram, cowpea, ragi, foxtail millet) and sowing dates`,who_to_contact:`Local agriculture office / KVK`}],bV=[{crop:`Paddy`,season:`kharif`,season_length_days:120,total_water_need_mm_min:1e3,total_water_need_mm_max:1400,drought_tolerance:`low`,stage:`Establishment`,stage_days:20,stage_water_share_pct:15,is_critical_stage:!1,critical_stage_note:``},{crop:`Paddy`,season:`kharif`,season_length_days:120,total_water_need_mm_min:1e3,total_water_need_mm_max:1400,drought_tolerance:`low`,stage:`Vegetative growth`,stage_days:35,stage_water_share_pct:25,is_critical_stage:!1,critical_stage_note:``},{crop:`Paddy`,season:`kharif`,season_length_days:120,total_water_need_mm_min:1e3,total_water_need_mm_max:1400,drought_tolerance:`low`,stage:`Flowering and grain set`,stage_days:35,stage_water_share_pct:40,is_critical_stage:!0,critical_stage_note:`Panicle initiation to flowering`},{crop:`Paddy`,season:`kharif`,season_length_days:120,total_water_need_mm_min:1e3,total_water_need_mm_max:1400,drought_tolerance:`low`,stage:`Maturity`,stage_days:30,stage_water_share_pct:20,is_critical_stage:!1,critical_stage_note:``},{crop:`Maize`,season:`kharif`,season_length_days:110,total_water_need_mm_min:500,total_water_need_mm_max:700,drought_tolerance:`medium